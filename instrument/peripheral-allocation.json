  "source_review": {
    "native_control": "Bsp.cpp startLinkTransport: Serial1.setTX/setRX; UART0 in the installed Arduino core.",
    "motor_spi": "MotionSetup.cpp configureBus: SPI.setSCK/setTX/setRX, TMC chip select remains SIO.",
    "torque_spi": "BrakeTorqueHw.hpp beginAdc: SPI1 supplied by Bsp.cpp, CONVST/CS remains SIO.",
    "shared_dacs": "Bsp.cpp: Wire.setSDA/setSCL, I2C0 shared by both DAC addresses.",
    "qs_tx": "Bsp.cpp constructs SerialPIO(kFwTrig1, NOPIN). Installed core TX program uses six instructions and one SM; RX-only IRQ path is not active. No PIO block is fixed.",
    "scope": "Reviewed production revision 2 configuration, not preprocessor inference or an inventory of every SDK/USB/alarm/IRQ/DMA resource.",
    "analog_monitors": "ADC0/ADC2 in PowerSequence, ADC1 in BrakeTorqueHw; ADC3 is reserved angle readback used by SelfTest. This is the pin budget, not a claim that every monitor runs in the delivery loop."
  },
