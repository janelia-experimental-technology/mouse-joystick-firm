    affiliation: "Janelia Research Campus, Howard Hughes Medical Institute"
repository-code: "https://github.com/peterpolidoro/mouse-joystick-firm"
version: "1.0.0"
date-released: "2026-10-13"
license: BSD-3-Clause
keywords:
  - pyControl
  - RP2040
  - TMC5130
  - joystick
  - behavioral neuroscience
  - firmware
